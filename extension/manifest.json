{
  "manifest_version": 3,
  "name": "MCP Web LLMs Bridge",
  "version": "1.1.0",
  "description": "Bridge ChatGPT, Gemini, Kimi, and Z.ai Web in this Chrome Profile to MCP Server",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://chatgpt.com/*",
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://*.kimi.ai/*",
    "https://kimi.ai/*",
    "https://*.z.ai/*",
    "https://z.ai/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chatgpt.com/*",
        "https://chatgpt.com/*",
        "https://*.google.com/*",
        "https://gemini.google.com/*",
        "https://*.kimi.ai/*",
        "https://kimi.ai/*",
        "https://*.z.ai/*",
        "https://z.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MCP Web LLMs Bridge"
  }
}
