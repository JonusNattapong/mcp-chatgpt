{
  "name": "mcp-chatgpt",
  "version": "1.0.0",
  "description": "MCP Server to ask and chat through ChatGPT Web using browser automation",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-chatgpt": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "start": "node dist/index.js",
    "bridge": "node dist/index.js --bridge-only",
    "login": "node dist/index.js --login",
    "dev": "tsc && node dist/index.js"
  },
  "keywords": [
    "mcp",
    "chatgpt",
    "chatgpt-web",
    "model-context-protocol",
    "playwright",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "commander": "^13.1.0",
    "playwright": "^1.50.1",
    "ws": "^8.21.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.2"
  }
}
